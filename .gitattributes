# Line endings (docs/01-architecture.md, section 13.3)
* text=auto
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Git LFS (docs/01-architecture.md, section 13.2)
# 3D models
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
